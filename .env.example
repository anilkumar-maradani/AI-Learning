# PolicyLens — local configuration
# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# Required. Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional. Any chat model served by Groq (default shown).
# GROQ_MODEL=openai/gpt-oss-120b

# Week 9. Token the claims-system MCP server checks; mcp_config.json passes it through.
CLAIMS_API_TOKEN=dev-claims-token

# Week 9 bonus. The agent's token for the gateway (mcp_config.gateway.json). This dev
# token is scoped to deny claims_system__get_adjuster_notes (mcp_servers/gateway/gateway_config.json).
GATEWAY_TOKEN=gw-triage-dev-token
