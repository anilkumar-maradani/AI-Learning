# PolicyLens — local configuration
# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# Required. Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional. Any chat model served by Groq (default shown).
# GROQ_MODEL=openai/gpt-oss-120b
