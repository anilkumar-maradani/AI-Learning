{
  "mcpServers": {
    "policy_docs": {
      "command": "${python}",
      "args": ["mcp_servers/policy_docs/server.py"],
      "attach_resources": ["policy://exclusion-schedule"]
    },
    "claims_system": {
      "command": "${python}",
      "args": ["mcp_servers/claims_system/server.py"],
      "env": {"CLAIMS_API_TOKEN": "${CLAIMS_API_TOKEN}"}
    }
  }
}
